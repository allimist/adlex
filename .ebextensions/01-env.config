option_settings:
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    Port: '80'
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    TRUST_PROXY: "1"
    COOKIE_SECURE: "false"
    DB_DRIVER: json
    DB_STRICT: "1"
    DATA_DIR: /var/app/data
    LOG_CLICKS: "1"
# Secrets are NOT here. Set them once per environment:
#   eb setenv SESSION_SECRET=<long random> ADMIN_EMAIL=you@example.com ADMIN_PASSWORD=<strong> BASE_URL=https://your.domain
# Flip COOKIE_SECURE=true once HTTPS is terminated at the load balancer.
