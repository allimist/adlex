# Server
PORT=8080
NODE_ENV=development
# Public base URL used to render campaign click URLs
BASE_URL=http://localhost:8080

# Data layer: json (local files) | firestore (later)
DB_DRIVER=json
DATA_DIR=./data
# Throw on queries that Firestore would reject (keeps us migration-safe)
DB_STRICT=1

# Sessions / cookies
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
# Number of proxy hops to trust for X-Forwarded-For (1 behind ALB, 2 behind CloudFront+ALB)
TRUST_PROXY=0

# First admin account (created on boot if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Log one JSON line per click/postback to stdout
LOG_CLICKS=1

# Event bus between tracking endpoints and the database: direct | kafka
BUS_DRIVER=direct
# With kafka: run `node worker.js` to consume
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC=adlex.events
# KAFKA_GROUP=adlex-ingest
# KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Website collector (/se/, /pc/) requests per IP per minute
COLLECT_RATE_PER_MIN=120

# db.bestoffers.biz-compatible raw dumps /se/export and /pc/export (?code=). Empty = disabled.
LEGACY_REPORT_CODE=
